{
  "name": "era-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run src/core/mod-validate.test.ts",
    "gen:catalog": "node scripts/gen-native-catalog.cjs",
    "check:catalog": "node scripts/gen-native-catalog.cjs --check",
    "scan:attrs": "node scripts/scan-attr-refs.cjs",
    "scan:erark": "node scripts/scan-erark-defs.cjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@vueuse/core": "^14.3.0",
    "dexie": "^4.4.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
